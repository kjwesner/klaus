{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "klaus",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KLAUS_APPLICATION",
        "class_name": "KlausApplication"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KlausApplication"]
    }
  ]
}
